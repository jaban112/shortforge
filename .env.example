# copy to .env — never commit .env
# --- YouTube (required for upload) — get all three from `python -m shortforge auth`
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# --- optional
ANTHROPIC_API_KEY=            # empty = template writer (verbatim source sentences). set = LLM writer, grounding-gated
NASA_API_KEY=DEMO_KEY         # api.nasa.gov (free key raises the rate limit; DEMO_KEY works)

# --- content
SHORTFORGE_PACK=onthisday     # onthisday | apod
SHORTFORGE_CHANNEL_NAME=Today in History
SHORTFORGE_VIDEOS_PER_RUN=1
SHORTFORGE_TARGET_SECONDS=45
SHORTFORGE_MAX_SECONDS=58
SHORTFORGE_VOICE=am_michael   # kokoro voices: af_heart af_bella am_michael am_adam bm_george bf_emma ...
SHORTFORGE_SPEED=1.05
SHORTFORGE_PRIVACY=public     # public | unlisted | private  (start with unlisted if you want to eyeball the first ones)
SHORTFORGE_UPLOAD=false       # the GitHub workflow sets this true itself
SHORTFORGE_MUSIC=true
SHORTFORGE_MUSIC_GAIN_DB=-22
